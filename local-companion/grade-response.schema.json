{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["reply", "grade", "suggestedNextAction"],
  "properties": {
    "reply": { "type": "string" },
    "suggestedNextAction": { "type": "string", "enum": ["ask", "revise", "pass"] },
    "grade": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["score", "passed", "summary", "strengths", "improvements", "criteria"],
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "passed": { "type": "boolean" },
            "summary": { "type": "string" },
            "strengths": { "type": "array", "maxItems": 3, "items": { "type": "string" } },
            "improvements": { "type": "array", "maxItems": 3, "items": { "type": "string" } },
            "criteria": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["criterion", "met", "evidence"],
                "properties": {
                  "criterion": { "type": "string" },
                  "met": { "type": "boolean" },
                  "evidence": { "type": "string" }
                }
              }
            }
          }
        }
      ]
    }
  }
}
