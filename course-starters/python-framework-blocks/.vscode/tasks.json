{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "验证当前积木",
      "type": "shell",
      "command": "python3",
      "args": [
        "verify.py",
        "--block",
        "${input:blockNumber}"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
